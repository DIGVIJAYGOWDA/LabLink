# Reference of all environment variables. Real values go in the
# git-ignored files frontend/.env and backend/.env (see their .env.example).
# Placeholders only - never commit real keys.

# --- frontend/.env ---
VITE_API_BASE_URL=http://localhost:8000

# --- backend/.env ---
ENVIRONMENT=development
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
BOOKING_WINDOW_DAYS=14
DATA_BACKEND=auto
DATABASE_TIMEOUT_SECONDS=10
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_SECONDS=25
ASSISTANT_RATE_LIMIT_PER_MINUTE=20
