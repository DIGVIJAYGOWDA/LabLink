# Copy to .env (git-ignored). Placeholders only - never commit real keys.

# --- Server ---
# development | production | test (production hides /docs)
ENVIRONMENT=development
# Port used by `python -m app.main`
PORT=8000
LOG_LEVEL=INFO

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# --- Booking rules ---
BOOKING_WINDOW_DAYS=14

# --- Database: Supabase PostgreSQL ---
# auto = Supabase when the two values below are set, otherwise in-memory mock data (not persistent)
# supabase = always Supabase (requests fail with 503 if not configured) | memory = always mock data
DATA_BACKEND=auto
DATABASE_TIMEOUT_SECONDS=10
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Service-role (secret) key: server-side only, never put it in the frontend or in Git
SUPABASE_SERVICE_ROLE_KEY=

# --- AI: Google Gemini (chatbot + conflict explanations) ---
# Free key: https://aistudio.google.com/apikey . Without it the chatbot answers with a plain free-slot list.
GEMINI_API_KEY=
# Model ids (aliases track Google's current models). The fallback is used when the primary is busy.
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_SECONDS=25
# Max assistant questions per client per minute (protects your Gemini quota)
ASSISTANT_RATE_LIMIT_PER_MINUTE=20
